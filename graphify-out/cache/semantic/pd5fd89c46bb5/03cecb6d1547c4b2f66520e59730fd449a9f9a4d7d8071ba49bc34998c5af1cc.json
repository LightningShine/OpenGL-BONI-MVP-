{"nodes": [{"id": "docs_notes_vehicle_focus_multidigit_focus_selection", "label": "Vehicle focus selection (P key)", "file_type": "concept", "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:6-38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P cycles three states: start ID entry, cancel entry, or reset g_focused_vehicle_id to -1 (leader tracking). Edge detection via a wasPPressed static because GLFW reports held keys as PRESS every frame."}, {"id": "docs_notes_vehicle_focus_multidigit_multidigit_input", "label": "Multi-digit vehicle ID entry", "file_type": "concept", "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:41-93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Digits accumulate into a string confirmed by ENTER so IDs like 12 or 345 are reachable, unlike a single-keypress scheme; per-digit press latches prevent one keypress from appending repeatedly."}, {"id": "docs_notes_vehicle_focus_multidigit_input_timeout", "label": "10-second focus input timeout", "file_type": "rationale", "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:47-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FOCUS_INPUT_TIMEOUT measured against glfwGetTime cancels a half-typed ID so the app cannot get stuck swallowing digit keys if the operator walks away mid-entry."}, {"id": "docs_notes_vehicle_focus_multidigit_existence_check", "label": "Focus target existence check under g_vehicles_mutex", "file_type": "rationale", "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:74-88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entered ID is looked up in g_vehicles under a lock_guard before g_focused_vehicle_id is set, so the camera never latches onto a vehicle that does not exist; a missing ID is reported and the mode exits."}], "edges": [{"source": "docs_notes_vehicle_focus_multidigit_focus_selection", "target": "docs_notes_vehicle_focus_multidigit_multidigit_input", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_multidigit_input", "target": "docs_notes_vehicle_focus_multidigit_input_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_multidigit_input", "target": "docs_notes_vehicle_focus_multidigit_existence_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_focus_selection", "target": "opengl_src_core_main_processinput", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:3", "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_existence_check", "target": "opengl_src_vehicle_vehicle_g_vehicles", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": "docs/notes/vehicle-focus-multidigit.md:78-80", "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_focus_selection", "target": "readme_hotkeys", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_vehicle_focus_multidigit_focus_selection", "target": "readme_track_visualization", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/notes/vehicle-focus-multidigit.md", "source_location": null, "weight": 1.0}], "hyperedges": []}