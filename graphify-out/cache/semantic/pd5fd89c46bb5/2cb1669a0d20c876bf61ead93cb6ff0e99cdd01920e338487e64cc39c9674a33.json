{"nodes": [{"id": "opengl_claude_rajagp_client", "label": "RAJAGP Client (Windows desktop app)", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C++17 / OpenGL 3.3 (glad) + GLFW + Dear ImGui timing and telemetry client for RC-car and karting races."}, {"id": "opengl_claude_arm64_build_target", "label": "ARM64 dev build target", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARM64 is the fast local dev target on this Windows-on-ARM machine; x64 previously crashed with 0xc000007b because vcpkg deps were only installed for the arm64 triplet and arm64 DLLs were picked up."}, {"id": "opengl_claude_x64_distribution_target", "label": "x64 distribution target", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "installer/installer.iss packages x64\\Release specifically, so x64 must be rebuilt before regenerating the installer even though daily dev happens on ARM64."}, {"id": "opengl_claude_sqlite3_both_triplets", "label": "sqlite3 required for both vcpkg triplets", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The device registry database needs sqlite3; missing it in either triplet breaks link or startup. sqlite3.dll is applocal-deployed next to the exe and swept into the installer by the *.dll wildcard."}, {"id": "opengl_claude_rajagp_core", "label": "rajagp_core shared protocol library", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client compiles Crc.cpp and RajaParser.cpp straight out of the sibling closed RAJAGP Server repo so client and server share exactly one packet format; the build fails without that neighbouring directory."}, {"id": "opengl_claude_include_root_convention", "label": "src as single #include root", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:43-57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$(ProjectDir)src is the only header root, so there are no relative ../.. includes. Not cosmetic: while paths were file-relative, moving any file broke its neighbours' includes and the same header was spelled three different ways."}, {"id": "opengl_claude_telemetry_pipeline", "label": "Telemetry ingest pipeline (processIncomingTelemetry -> g_vehicles)", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:59-65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three independent data sources (COM/serial, Track Server WebSocket, simulator) converge into one pipeline so there is exactly one implementation of vehicle-state assembly."}, {"id": "opengl_claude_com_serial_source", "label": "COM / serial data source (SX1280 LoRa receiver)", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ports are discovered automatically on a background thread; packet format is shared with the server through rajagp_core's RajaParser."}, {"id": "opengl_claude_track_server_source", "label": "Track Server WebSocket data source", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately built on native WinHTTP instead of a third-party socket library so it works on ARM64; owns a reconnecting connection thread and tracks channel quality (loss, jitter)."}, {"id": "opengl_claude_simulation_source", "label": "Built-in simulator data source", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates vehicles on the loaded track so the app can be exercised without hardware."}, {"id": "opengl_claude_pending_consume_pattern", "label": "pending-consume hand-off pattern", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network/serial threads never touch OpenGL; data crosses into the render thread as a pending item consumed there (e.g. server track geometry) because GPU upload must happen on the context thread. Shared data otherwise sits behind mutexes such as g_track_mutex and points_mutex."}, {"id": "opengl_claude_authoritative_server_timing", "label": "Server timings are authoritative", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RaceManager computes laps, sectors, deltas and positions locally for COM/simulator, but when connected to Track Server the server's timings overwrite the local calculation; serverPosition == 0 marks a local session."}, {"id": "opengl_claude_ascii_only_console_output", "label": "English-only identifiers and console output", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:108-110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project builds without /utf-8, so Cyrillic in narrow string literals becomes '?' at compile time; SetConsoleOutputCP(CP_UTF8) in main.cpp fixes display only, not compilation. Runtime data (track and device names from SQLite, paths) is not a literal and passes through correctly."}, {"id": "opengl_claude_legacy_ui_duplicate_files", "label": "Legacy UI.cpp de-duplication", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI.cpp/UI_Elements.cpp used to live at project root while identically named empty stubs sat in src/ui outside the build, so editing 'the' file changed nothing. The stubs and the name collision are gone - there is exactly one file."}, {"id": "opengl_claude_apppaths_convention", "label": "AppPaths single source of data directories", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything the app writes lives under one saves/ root (tracks, results, replays, logs). Paths are declared once in core/AppPaths.h and never spelled as string literals in new code; AppPaths::prepare() runs first in main to create the tree and migrate the old layout (src/saves, race saves, logs)."}, {"id": "opengl_claude_local_state_not_versioned", "label": "Local UI state files excluded from git", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "imgui.ini, pro_scales.ini, pro_panels.ini, ui_scale.ini, recent_files.txt and devices.db are per-machine state, so they are written next to the working directory and never committed."}, {"id": "opengl_claude_dual_edge_track", "label": "Dual-edge track creation", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driving the left edge and then the right edge yields a track with real borders, unlike single-lap telemetry recording which only gives a centre line."}, {"id": "opengl_claude_trk2_format", "label": ".trk2 binary track format", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Header plus two polylines with UTM georeferencing via GeographicLib, stored in saves/tracks/; the same track can also arrive from the server in chunks."}, {"id": "opengl_claude_coordinate_frame_conventions", "label": "Coordinate frame conventions (txt / trk2 / sim, render offset)", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The conventions are subtle, so anything positional must be checked against src/rendering/Render.* and TrackEditor before changing."}, {"id": "opengl_claude_device_registry", "label": "Device registry (SQLite devices.db)", "file_type": "concept", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite-backed registry of tracker names/groups in src/core/DeviceRegistry; it is why sqlite3 is a hard dependency of both triplets."}, {"id": "opengl_claude_no_tests_no_linter", "label": "No automated tests or linter", "file_type": "rationale", "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project has no autotests and no linter, so correctness rests on code review and the coding standard rather than CI."}], "edges": [{"source": "opengl_claude_rajagp_client", "target": "readme_rajagp_client", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "opengl_claude_rajagp_client", "target": "opengl_claude_rajagp_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:20", "weight": 1.0}, {"source": "opengl_claude_rajagp_core", "target": "readme_rajagp_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:20", "weight": 1.0}, {"source": "opengl_claude_arm64_build_target", "target": "opengl_claude_x64_distribution_target", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:17-18", "weight": 1.0}, {"source": "opengl_claude_x64_distribution_target", "target": "readme_installer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:18", "weight": 1.0}, {"source": "opengl_claude_sqlite3_both_triplets", "target": "opengl_claude_device_registry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:19", "weight": 1.0}, {"source": "opengl_claude_device_registry", "target": "opengl_src_core_deviceregistry_deviceregistry", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:19", "weight": 1.0}, {"source": "opengl_claude_telemetry_pipeline", "target": "opengl_claude_com_serial_source", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:61-63", "weight": 1.0}, {"source": "opengl_claude_telemetry_pipeline", "target": "opengl_claude_track_server_source", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:61-64", "weight": 1.0}, {"source": "opengl_claude_telemetry_pipeline", "target": "opengl_claude_simulation_source", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:61-65", "weight": 1.0}, {"source": "opengl_claude_com_serial_source", "target": "opengl_src_network_esp32_code_esp32_code", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:63", "weight": 1.0}, {"source": "opengl_claude_track_server_source", "target": "opengl_src_network_trackserverclient_trackserverclient", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:64", "weight": 1.0}, {"source": "opengl_claude_simulation_source", "target": "opengl_src_network_simulationserver_simulationserver", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:65", "weight": 1.0}, {"source": "opengl_claude_pending_consume_pattern", "target": "opengl_src_network_trackserverclient_consumependingtrack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:69", "weight": 1.0}, {"source": "opengl_claude_pending_consume_pattern", "target": "docs_coding_standards_queue_over_mutex", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "OpenGL/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "opengl_claude_pending_consume_pattern", "target": "docs_coding_standards_gl_calls_own_thread", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:69", "weight": 1.0}, {"source": "opengl_claude_authoritative_server_timing", "target": "opengl_src_racing_racemanager_racemanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:73", "weight": 1.0}, {"source": "opengl_claude_authoritative_server_timing", "target": "opengl_claude_track_server_source", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:73", "weight": 1.0}, {"source": "opengl_claude_apppaths_convention", "target": "opengl_src_core_apppaths_prepare", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:84", "weight": 1.0}, {"source": "opengl_src_core_main_main", "target": "opengl_src_core_apppaths_prepare", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:84", "weight": 1.0}, {"source": "opengl_claude_dual_edge_track", "target": "opengl_claude_trk2_format", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "weight": 1.0}, {"source": "opengl_claude_dual_edge_track", "target": "opengl_src_track_trackrecorder_trackrecorder", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "weight": 1.0}, {"source": "opengl_claude_coordinate_frame_conventions", "target": "opengl_claude_trk2_format", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:88", "weight": 1.0}, {"source": "opengl_claude_ascii_only_console_output", "target": "docs_coding_standards_naming_convention", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:108-110", "weight": 1.0}, {"source": "opengl_claude_include_root_convention", "target": "readme_source_layout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:43-57", "weight": 1.0}, {"source": "opengl_claude_legacy_ui_duplicate_files", "target": "opengl_claude_include_root_convention", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "OpenGL/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "opengl_claude_no_tests_no_linter", "target": "docs_code_review_severity_scale", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "OpenGL/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "opengl_claude_local_state_not_versioned", "target": "readme_pit_wall_pro_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md", "source_location": "OpenGL/CLAUDE.md:79", "weight": 1.0}], "hyperedges": [{"id": "telemetry_sources_converge_on_one_pipeline", "label": "Three data sources converge on a single telemetry ingest path", "nodes": ["opengl_claude_com_serial_source", "opengl_claude_track_server_source", "opengl_claude_simulation_source", "opengl_claude_telemetry_pipeline", "docs_code_review_single_ingest_path"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OpenGL/CLAUDE.md"}]}