{"nodes": [{"id": "docs_notes_race_display_implementation_racestatusbar", "label": "RaceStatusBar", "file_type": "concept", "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:22-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-of-screen race session bar: OpenGL-drawn background, borders and flags, with text drawn separately on the ImGui foreground draw list to keep the two rendering concerns apart. Not thread-safe by design - UI thread only."}, {"id": "docs_notes_race_display_implementation_raceflags", "label": "RaceFlags / FlagColor", "file_type": "concept", "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:16-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag colour management: FlagColor enum (Green, Yellow, Red, Blue, White, Checkered), colour-to-RGBA conversion, and left/right flag state."}, {"id": "docs_notes_race_display_implementation_racedisplay", "label": "RaceDisplay wrapper", "file_type": "concept", "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:34-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-level wrapper owning initialization, screen-resize handling and render orchestration, so callers do not touch the status bar internals."}, {"id": "docs_notes_race_display_implementation_responsive_scaling", "label": "Responsive scaling from a 1600x900 reference", "file_type": "rationale", "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:96-116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base geometry (256x25 bar, 16x16 flags, 0.5x text) is defined at 1600x900 and scaled by the average of scaleX and scaleY, with minimum clamps on border (1px) and spacing (2px), so one layout covers XGA through 4K without per-resolution tuning."}, {"id": "docs_notes_race_display_implementation_modemanager_integration", "label": "Automatic phase detection from ModeManager", "file_type": "rationale", "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:118-131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bar reads GetPhaseLabel() and GetPhase() straight from ModeManager and derives the left flag colour from the phase (Yellow for Practice, Green otherwise), so no duplicate flag state has to be kept in sync."}], "edges": [{"source": "docs_notes_race_display_implementation_racedisplay", "target": "docs_notes_race_display_implementation_racestatusbar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_race_display_implementation_racestatusbar", "target": "docs_notes_race_display_implementation_raceflags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_race_display_implementation_racestatusbar", "target": "docs_notes_race_display_implementation_responsive_scaling", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_race_display_implementation_modemanager_integration", "target": "opengl_src_racing_modemanager_modemanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:118-131", "weight": 1.0}, {"source": "docs_notes_race_display_implementation_racestatusbar", "target": "docs_notes_race_display_implementation_modemanager_integration", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_race_display_implementation_raceflags", "target": "readme_race_flags", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_notes_race_display_implementation_modemanager_integration", "target": "readme_race_phases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md", "source_location": "docs/notes/race-display-implementation.md:124-131", "weight": 1.0}, {"source": "docs_notes_race_display_implementation_responsive_scaling", "target": "opengl_src_ui_ui_scale_ui_scale", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/notes/race-display-implementation.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "race_status_bar_composition", "label": "Race status bar: display wrapper, bar, flags and phase source", "nodes": ["docs_notes_race_display_implementation_racedisplay", "docs_notes_race_display_implementation_racestatusbar", "docs_notes_race_display_implementation_raceflags", "docs_notes_race_display_implementation_responsive_scaling", "docs_notes_race_display_implementation_modemanager_integration"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/notes/race-display-implementation.md"}]}